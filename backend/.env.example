# ==============================================================================
# Backend Environment Configuration (.env)
# ==============================================================================

# --- Database (Neon Serverless PostgreSQL) ---
# Format: postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=""

# --- Core LLM Providers (Fast & Heavy Distributed Tiers) ---
GROQ_API_KEY=""
GEMINI_API_KEY=""

# --- Specialized Tools & APIs ---
TAVILY_API_KEY=""
OPENWEATHER_API_KEY=""
AVIATION_STACK_API_KEY=""

# --- Observability: LangSmith (Optional) ---
LANGSMITH_API_KEY=""
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="Agentic-AI-Travel-Assistant"

# --- Observability: Langfuse v5 (Optional) ---
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# --- Observability: Sentry (Optional) ---
SENTRY_DSN=""

# --- Security / CORS ---
# Comma-separated list of extra origins (Vercel *.vercel.app is allowed by default)
ALLOWED_ORIGINS=""
